% Minimal poster theme, adapted from the user's previous posters.
\RequirePackage{exscale}
\RequirePackage{ragged2e}
\RequirePackage{changepage}
\RequirePackage{fontspec}
\RequirePackage{calc}
\RequirePackage[skins,theorems]{tcolorbox}

\newfontfamily\Raleway[Ligatures=TeX]{Lato}
\newfontfamily\Lato[Ligatures=TeX]{Lato}
\usefonttheme{professionalfonts}

\setbeamerfont{headline}{family=\Raleway}
\setbeamerfont{headline title}{size=\Huge,series=\bfseries}
\setbeamerfont{headline author}{size=\LARGE}
\setbeamerfont{headline institute}{size=\normalsize}
\setbeamerfont{block title}{family=\Raleway,size=\Large,series=\bfseries}
\setbeamerfont{block body}{size=\large}
\setbeamerfont{heading}{family=\Lato,series=\bfseries}
\setbeamerfont{caption}{size=\normalsize}
\setbeamerfont{footline}{family=\Raleway,size=\normalsize}

\makeatletter
\def\@listi{\leftmargin\leftmarginii
\topsep 0.8ex
\parsep 0\p@ \@plus\p@
\itemsep 0.45ex}
\makeatother

\setbeamertemplate{itemize item}{\raise0.45ex \hbox{\vrule width 0.5ex height 0.5ex}}
\setbeamertemplate{itemize subitem}{\raise0.25ex \hbox{\vrule width 0.45ex height 0.45ex}}
\setbeamertemplate{itemize subsubitem}{\raise0.2ex \hbox{\vrule width 0.4ex height 0.4ex}}
\setbeamertemplate{caption}[numbered]
\setbeamertemplate{caption label separator}[period]
\setbeamertemplate{bibliography item}[text]
\beamertemplatenavigationsymbolsempty

\setbeamertemplate{headline}{
  \begin{beamercolorbox}[wd=\paperwidth]{headline}
    \vspace{3ex}
    \centering
    {\usebeamerfont{headline title}\usebeamercolor[fg]{headline title}\inserttitle\par}
    \vspace{0.7ex}
    {\usebeamerfont{headline author}\usebeamercolor[fg]{headline author}\insertauthor\par}
    \vspace{0.6ex}
    {\usebeamerfont{headline institute}\usebeamercolor[fg]{headline institute}\insertinstitute\par}
    \vspace{2.5ex}
  \end{beamercolorbox}
}

\setbeamertemplate{block begin}{
  \vspace{0.4ex}
  {\usebeamerfont{block title}\usebeamercolor[fg]{block title}\insertblocktitle\par}
  \vspace{0.7ex}
  \usebeamerfont{block body}
  \begin{beamercolorbox}[wd=\linewidth,colsep*=0ex]{block body}
  \justifying
  \setlength{\parskip}{0.8ex}
}
\setbeamertemplate{block end}{
  \end{beamercolorbox}
  \vspace{1.8ex}
}

\setbeamertemplate{block alerted begin}{
  \begin{tcolorbox}[colback=accentbg,colframe=accent,boxrule=0pt,left=8pt,right=8pt,top=8pt,bottom=8pt,arc=1.5mm]
  \usebeamerfont{block body}
  \justifying
  \setlength{\parskip}{0.8ex}
}
\setbeamertemplate{block alerted end}{
  \end{tcolorbox}
  \vspace{1.2ex}
}

\newcommand{\footercontent}[1]{\newcommand{\insertfootercontent}{#1}}
\setbeamertemplate{footline}{
  \ifdefined\insertfootercontent
  \begin{beamercolorbox}[wd=\paperwidth,vmode]{footline}
    \vspace{1.6ex}
    \hspace{\sepwidth}
    \usebeamerfont{footline}\insertfootercontent
    \hspace{\sepwidth}
    \vspace{1.8ex}
  \end{beamercolorbox}
  \fi
}
